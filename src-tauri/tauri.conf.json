{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-Angle Edit",
  "version": "26.11.7",
  "identifier": "com.nekolegends.multiangleedit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Multi-Angle Edit",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../python/multi_angle_worker.py"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Local multi-angle image editor",
    "longDescription": "Multi-Angle Edit re-renders an image from a new camera angle using Qwen-Image-Edit with the Multiple-Angles LoRA, driven by an interactive 3D angle picker. Runs locally on your own GPU."
  }
}
